#!/usr/bin/env bash
# tests/fixtures/mock-gemini — Gemini CLI test double
# 模拟 gemini CLI `--output-format stream-json` 行为：
# stdout 输出 JSONL events 流（含 _received_* 字段用于测试断言）
# 在 ${GEMINI_CLI_HOME:-$HOME}/.gemini/tmp/ 下写 native session（DEV-3 mock 扩展点）
# 参见 docs/architecture/integrations.md §Gemini CLI Session 机制
set -euo pipefail

received_model=""
received_approval_mode=""
received_output_format=""
received_prompt=""
received_skip_trust="false"

# 解析 gemini flags（-p/--prompt 接收 prompt 正文；其余 flag 记录用于断言）
# 支持 --flag value 和 --flag=value 两种形式
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p|--prompt)            received_prompt="$2";            shift 2 ;;
    --model)                received_model="$2";             shift 2 ;;
    --model=*)              received_model="${1#--model=}";  shift   ;;
    --approval-mode)        received_approval_mode="$2";     shift 2 ;;
    --approval-mode=*)      received_approval_mode="${1#--approval-mode=}"; shift ;;
    --output-format)        received_output_format="$2";     shift 2 ;;
    --output-format=*)      received_output_format="${1#--output-format=}"; shift ;;
    --sandbox)              shift 2 ;;  # ignore for now
    --skip-trust)           received_skip_trust="true"; shift ;;
    --yolo)                 received_approval_mode="yolo";   shift   ;;
    *)                      shift ;;
  esac
done

scenario="${RALPH_MOCK_GEMINI_SCENARIO:-happy}"

# ── stdout JSONL events（--output-format stream-json 模式）──────────────────
_emit_init() {
  local _sid="${1:-${RALPH_MOCK_GEMINI_SESSION_ID:-mock-gemini-session-001}}"
  jq -nc \
    --arg model "$received_model" \
    --arg approval_mode "$received_approval_mode" \
    --arg output_format "$received_output_format" \
    --arg skip_trust "$received_skip_trust" \
    --arg prompt_preview "${received_prompt:0:100}" \
    --arg session_id "$_sid" \
    '{type:"init",session_id:$session_id,_received_model:$model,_received_approval_mode:$approval_mode,_received_output_format:$output_format,_received_skip_trust:$skip_trust,_received_prompt_preview:$prompt_preview}'
}

# 真实 CLI 事件类型（QA-2 验证）
_emit_message() {
  local text="$1"
  jq -nc --arg text "$text" \
    '{type:"message",role:"assistant",delta:true,text:$text}'
}

_emit_result() {
  local text="$1"
  jq -nc --arg text "$text" \
    '{type:"result",text:$text}'
}

_emit_tool_use() {
  local name="${1:-Bash}"
  local cmd="${2:-echo hello}"
  jq -nc --arg name "$name" --arg cmd "$cmd" \
    '{type:"tool_use",name:$name,input:{command:$cmd}}'
}

_emit_tool_result() {
  local output="${1:-hello}"
  jq -nc --arg output "$output" \
    '{type:"tool_result",content:$output}'
}

_emit_error() {
  local msg="$1"
  jq -nc --arg msg "$msg" \
    '{type:"error",error:{message:$msg}}'
}

# ── 写 native Gemini session 文件（DEV-3 mock 扩展点）────────────────────────
# 路径：${GEMINI_CLI_HOME:-$HOME}/.gemini/tmp/<project-id>/chats/session-*.json
_write_native_session() {
  local gemini_root="${GEMINI_CLI_HOME:-$HOME}/.gemini/tmp/mock-project/chats"
  mkdir -p "$gemini_root"
  local session_id="${1:-${RALPH_MOCK_GEMINI_SESSION_ID:-mock-gemini-session-001}}"
  local ts
  ts="$(date -u +"%Y-%m-%dT%H-%M")"
  local now_iso
  now_iso="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  cat > "$gemini_root/session-${ts}-${session_id}.json" << ENDJSON
{"sessionId":"$session_id","projectHash":"mock","startTime":"$now_iso","lastUpdated":"$now_iso","messages":[{"role":"user","parts":[{"text":"Do one task"}]},{"role":"model","parts":[{"text":"Done."}]}],"kind":"chat"}
ENDJSON
  echo "$gemini_root/session-${ts}-${session_id}.json"
}

# ── 勾选 TASKS.md 第 1 条未勾选任务（通过 RALPH_WORKSPACE）──────────────────
_check_first_task() {
  if [[ -n "${RALPH_WORKSPACE:-}" ]]; then
    local _tasks="${RALPH_WORKSPACE}/.ralph/TASKS.md"
    if [[ -f "$_tasks" ]]; then
      local _tmpout
      _tmpout="$(mktemp)"
      local _found=0
      while IFS= read -r _line || [[ -n "$_line" ]]; do
        if [[ "$_found" -eq 0 && "$_line" =~ ^([[:space:]]*-[[:space:]]+)\[[[:space:]]\](.*)$ ]]; then
          printf '%s[x]%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" >> "$_tmpout"
          _found=1
        else
          printf '%s\n' "$_line" >> "$_tmpout"
        fi
      done < "$_tasks"
      mv "$_tmpout" "$_tasks"
    fi
  fi
}

case "$scenario" in
  happy)
    _emit_init
    _emit_message "I will complete this task."
    _emit_tool_use "Bash" "echo hello"
    _emit_tool_result "hello"
    _emit_result "Done."

    # 写 native session（供 DEV-3 collect 测试使用）
    _write_native_session >/dev/null 2>&1 || true

    _check_first_task
    if [[ -n "${RALPH_MOCK_GEMINI_POST_STREAM_SLEEP:-}" ]]; then
      sleep "$RALPH_MOCK_GEMINI_POST_STREAM_SLEEP"
    fi
    exit 0
    ;;

  crash)
    # CLI 崩溃：不写任何 stdout，exit 1
    exit 1
    ;;

  session_mismatch)
    # Init 事件有 session_id，但 native session 文件有不同 sessionId → 触发 mtime fallback
    _emit_init
    _emit_message "I will complete this task."
    _emit_result "Done."
    _write_native_session "mismatch-file-session-id" >/dev/null 2>&1 || true
    _check_first_task
    exit 0
    ;;

  no_session_file)
    # Init 事件有 session_id，但不写 native session 文件 → capture_status=warning
    _emit_init
    _emit_message "I will complete this task."
    _emit_result "Done."
    # Intentionally don't write native session file
    _check_first_task
    exit 0
    ;;

  auth_error)
    _emit_init
    _emit_error "Unauthorized: 401 invalid API key"
    exit 1
    ;;

  rate_limit_error)
    _emit_init
    _emit_error "429 Too Many Requests: rate limit exceeded"
    exit 1
    ;;

  quota_error)
    _emit_init
    _emit_error "Quota exceeded: billing quota exhausted"
    exit 1
    ;;

  network_error)
    _emit_init
    _emit_error "ECONNRESET: connection refused"
    exit 1
    ;;

  api_error)
    _emit_init
    _emit_error "500 Internal Server Error"
    exit 1
    ;;

  unknown_error)
    _emit_init
    _emit_error "Something went wrong unexpectedly"
    exit 1
    ;;

  *)
    printf 'mock-gemini: unknown scenario: %s\n' "$scenario" >&2
    exit 1
    ;;
esac
