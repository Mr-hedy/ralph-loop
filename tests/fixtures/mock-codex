#!/usr/bin/env bash
# tests/fixtures/mock-codex — Codex CLI test double
# 模拟 codex exec --json 行为：
# stdout 输出 JSONL events 流（thread.started / item.completed / turn.completed / turn.failed / error）
# 在 ${CODEX_HOME:-$HOME/.codex}/sessions/ 下写 rollout 文件
# 参见 docs/architecture/integrations.md §Codex Session 机制
set -euo pipefail

thread_id=""
received_model=""
received_effort=""
received_sandbox=""
received_workspace=""

# 解析 codex exec flags（忽略其他参数）
while [[ $# -gt 0 ]]; do
  case "$1" in
    --model)       received_model="$2";      shift 2 ;;
    -c)            received_effort="$2";      shift 2 ;;
    --sandbox)     received_sandbox="$2";     shift 2 ;;
    -C)            received_workspace="$2";   shift 2 ;;
    --json)        shift ;;
    exec)          shift ;;
    *)             shift ;;
  esac
done

scenario="${RALPH_MOCK_CODEX_SCENARIO:-happy}"

# 生成 thread_id（固定值，便于测试断言）
thread_id="${RALPH_MOCK_CODEX_THREAD_ID:-thread-aaa111-bbb222}"

# stdout JSONL events（--json 模式）
_emit_thread_started() {
  jq -nc \
    --arg thread_id "$thread_id" \
    --arg model "$received_model" \
    --arg effort "$received_effort" \
    --arg sandbox "$received_sandbox" \
    --arg workspace "$received_workspace" \
    '{type:"thread.started",thread_id:$thread_id,_received_model:$model,_received_effort:$effort,_received_sandbox:$sandbox,_received_workspace:$workspace}'
}

_emit_item_completed_agent_message() {
  local text="$1"
  jq -nc --arg text "$text" \
    '{type:"item.completed",item:{type:"agent_message",text:$text}}'
}

_emit_item_started_command_execution() {
  local command="$1"
  local id="${2:-item_001}"
  jq -nc --arg cmd "$command" --arg id "$id" \
    '{type:"item.started",item:{id:$id,type:"command_execution",command:$cmd,status:"in_progress"}}'
}

_emit_item_completed_command_execution() {
  local command="$1"
  local output="$2"
  local id="${3:-item_001}"
  jq -nc --arg cmd "$command" --arg out "$output" --arg id "$id" \
    '{type:"item.completed",item:{id:$id,type:"command_execution",command:$cmd,output:$out,exit_code:0}}'
}

_emit_turn_completed() {
  printf '{"type":"turn.completed"}\n'
}

_emit_turn_failed() {
  local msg="$1"
  printf '{"type":"turn.failed","error":{"message":"%s"}}\n' "$msg"
}

_emit_error() {
  local msg="$1"
  printf '{"type":"error","error":{"message":"%s"}}\n' "$msg"
}

# 写 ${CODEX_HOME:-$HOME/.codex}/sessions/YYYY/MM/DD/rollout-<ts>-<thread_id>.jsonl
_write_native_session() {
  local codex_root="${CODEX_HOME:-$HOME/.codex}"
  local ts
  ts="$(date -u +"%Y%m%d-%H%M%S")"
  local y m d
  y="$(date -u +"%Y")"
  m="$(date -u +"%m")"
  d="$(date -u +"%d")"
  local session_dir="$codex_root/sessions/$y/$m/$d"
  mkdir -p "$session_dir"
  local rollout_file="$session_dir/rollout-${ts}-${thread_id}.jsonl"
  cat > "$rollout_file" << ENDJSONL
{"type":"session_meta","payload":{"id":"$thread_id","cwd":"${received_workspace:-$PWD}","cli_version":"0.125.0"}}
{"type":"event_msg","payload":{"role":"user","content":"Do one task"}}
ENDJSONL
  echo "$rollout_file"
}

# 写归档 rollout：${CODEX_HOME:-$HOME/.codex}/archived_sessions/<fname>
# 文件名刻意不含 thread_id（Strategy 1 文件名匹配必失败），只有首行 payload.id 命中，
# 用于验证 provider_collect_session 的归档分支按内嵌 id 校验采集（REQ-030 / SC-030-1）
_write_archived_session() {
  local id="$1" fname="$2"
  local codex_root="${CODEX_HOME:-$HOME/.codex}"
  mkdir -p "$codex_root/archived_sessions" "$codex_root/sessions"
  local rollout_file="$codex_root/archived_sessions/$fname"
  cat > "$rollout_file" << ENDJSONL
{"type":"session_meta","payload":{"id":"$id","cwd":"${received_workspace:-$PWD}","cli_version":"0.125.0"}}
{"type":"event_msg","payload":{"role":"user","content":"Do one task"}}
ENDJSONL
  echo "$rollout_file"
}

# 写「文件名含 thread_id 但内嵌 id 不同」的活动 rollout
# 用于验证文件名匹配不再单独构成采集依据（必须按首行内嵌 id 校验内容，REQ-030 / DEV-4）
_write_named_decoy_session() {
  local codex_root="${CODEX_HOME:-$HOME/.codex}"
  local ts y m d
  ts="$(date -u +"%Y%m%d-%H%M%S")"
  y="$(date -u +"%Y")"
  m="$(date -u +"%m")"
  d="$(date -u +"%d")"
  local session_dir="$codex_root/sessions/$y/$m/$d"
  mkdir -p "$session_dir"
  local rollout_file="$session_dir/rollout-${ts}-${thread_id}.jsonl"
  cat > "$rollout_file" << ENDJSONL
{"type":"session_meta","payload":{"id":"thread-decoy-000","cwd":"${received_workspace:-$PWD}","cli_version":"0.125.0"}}
{"type":"event_msg","payload":{"role":"user","content":"decoy rollout from another thread"}}
ENDJSONL
  echo "$rollout_file"
}

# 写首行被截断（非法 JSON）的活动 rollout，文件名仍含 thread_id
# 用于验证「候选存在但不可解析」时 oneshot 不崩溃且留下诊断（REQ-030 / DEV-4）
_write_truncated_session() {
  local codex_root="${CODEX_HOME:-$HOME/.codex}"
  local ts y m d
  ts="$(date -u +"%Y%m%d-%H%M%S")"
  y="$(date -u +"%Y")"
  m="$(date -u +"%m")"
  d="$(date -u +"%d")"
  local session_dir="$codex_root/sessions/$y/$m/$d"
  mkdir -p "$session_dir"
  local rollout_file="$session_dir/rollout-${ts}-${thread_id}.jsonl"
  # 故意省略收尾花括号：模拟写入中途被截断
  printf '{"type":"session_meta","payload":{"id":"%s","cwd":"%s"\n' \
    "$thread_id" "${received_workspace:-$PWD}" > "$rollout_file"
  echo "$rollout_file"
}

# 写归档 rollout：首行 session_meta 无 id 字段（只有 cwd）
# 用于验证归档目录参与 mtime/cwd 降级（REQ-030 / DEV-4）
_write_archived_session_no_id() {
  local fname="$1"
  local codex_root="${CODEX_HOME:-$HOME/.codex}"
  mkdir -p "$codex_root/archived_sessions" "$codex_root/sessions"
  local rollout_file="$codex_root/archived_sessions/$fname"
  printf '{"type":"session_meta","payload":{"cwd":"%s","cli_version":"0.125.0"}}\n' \
    "${received_workspace:-$PWD}" > "$rollout_file"
  echo "$rollout_file"
}

# 勾选 TASKS.md 第 1 条未勾选任务（通过 RALPH_WORKSPACE）
_check_first_task() {
  if [[ -n "${RALPH_WORKSPACE:-}" ]]; then
    local _tasks="${RALPH_WORKSPACE}/.ralph/TASKS.md"
    if [[ -f "$_tasks" ]]; then
      local _tmpout
      _tmpout="$(mktemp)"
      local _found=0
      while IFS= read -r _line || [[ -n "$_line" ]]; do
        if [[ "$_found" -eq 0 && "$_line" =~ ^([[:space:]]*-[[:space:]]+)\[[[:space:]]\](.*)$ ]]; then
          printf '%s[x]%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" >> "$_tmpout"
          _found=1
        else
          printf '%s\n' "$_line" >> "$_tmpout"
        fi
      done < "$_tasks"
      mv "$_tmpout" "$_tasks"
    fi
  fi
}

case "$scenario" in
  happy)
    _emit_thread_started
    _emit_item_completed_agent_message "I will complete this"
    _emit_item_started_command_execution "echo hello" "item_001"
    _emit_item_completed_command_execution "echo hello" "hello" "item_001"
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed

    # 写 native session（供 collect 使用）
    _write_native_session >/dev/null

    _check_first_task
    if [[ -n "${RALPH_MOCK_CODEX_POST_STREAM_SLEEP:-}" ]]; then
      sleep "$RALPH_MOCK_CODEX_POST_STREAM_SLEEP"
    fi
    exit 0
    ;;

  happy_no_session)
    # stdout 正常但不写 native session（触发 mtime fallback 或 warning）
    _emit_thread_started
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    exit 0
    ;;

  missing_thread_id)
    # 不输出 thread.started，导致 session_id 缺失
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    _write_native_session >/dev/null
    exit 0
    ;;

  turn_failed_auth)
    _emit_thread_started
    _emit_turn_failed "Authentication failed: 401 unauthorized"
    exit 0
    ;;

  turn_failed_rate_limit)
    _emit_thread_started
    _emit_turn_failed "Rate limited: 429 too many requests"
    exit 0
    ;;

  turn_failed_quota)
    _emit_thread_started
    _emit_turn_failed "Quota exceeded: credits exhausted"
    exit 0
    ;;

  turn_failed_network)
    _emit_thread_started
    _emit_turn_failed "Network error: ECONNRESET connection reset"
    exit 0
    ;;

  turn_failed_api)
    _emit_thread_started
    _emit_turn_failed "API error: 500 internal server error"
    exit 0
    ;;

  turn_failed_unknown)
    _emit_thread_started
    _emit_turn_failed "Something unexpected went wrong"
    exit 0
    ;;

  error_event_auth)
    # error 事件 fallback：无 turn.failed，CLI 以非零退出
    _emit_thread_started
    _emit_error "Invalid API key: not logged in"
    exit 1
    ;;

  stderr_error)
    # 非 JSON stderr 输出（无 turn.failed / error 事件）
    _emit_thread_started
    printf 'Error: connection refused by remote host\n' >&2
    exit 1
    ;;

  crash)
    # CLI 崩溃：不写 stdout，exit 1
    exit 1
    ;;

  truncated_then_completed)
    # 截断行出现在合法 turn.completed 之前 → 终态仍须解析为 turn.completed / success
    _emit_thread_started
    printf '{"type":"item.completed","item":{"type":"agent_message","text":"cut off mid-wr\n'
    _emit_turn_completed
    _check_first_task
    exit 0
    ;;

  completed_then_error)
    # turn.completed 之后追加 error 事件（retry 循环遗留）→ turn.* 是权威终态，
    # 不得被末尾 error 事件覆盖为 error
    _emit_thread_started
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    _emit_error "transient retry notice: 429 too many requests"
    _check_first_task
    exit 0
    ;;

  error_only_rc0)
    # 只有 error 事件、无 turn.* 终态，且 CLI 以 0 退出 → 退化判定为 error，
    # rc 必须被 adapter 提升为非零（不得仅以退出码推断终态）
    _emit_thread_started
    _emit_error "Authentication failed: 401 unauthorized"
    exit 0
    ;;

  slow)
    sleep "${RALPH_MOCK_CODEX_SLEEP:-30}"
    ;;

  archived_session)
    # rollout 只存在于 archived_sessions/，且文件名不含 thread_id
    # → Strategy 1（文件名精确匹配）必失败，只能靠 Strategy 2 的内嵌 id 校验命中
    _emit_thread_started
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    _write_archived_session "$thread_id" "rollout-20260101-000000-notmatching.jsonl" >/dev/null
    _check_first_task
    exit 0
    ;;

  active_name_decoy)
    # 活动目录里存在文件名含 thread_id 的同名 rollout，但内嵌 id 是别的 thread；
    # 真实 rollout 在归档目录。→ 必须拒绝同名诱饵、按内嵌 id 从归档采集（DEV-4）
    _emit_thread_started
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    _write_named_decoy_session >/dev/null
    _write_archived_session "$thread_id" "rollout-20260101-000000-notmatching.jsonl" >/dev/null
    _check_first_task
    exit 0
    ;;

  truncated_rollout)
    # 活动目录里只有首行被截断的 rollout（非法 JSON）→ 不可解析候选不得让采集崩溃，
    # oneshot 仍须完成，并在 capture_warning 留下 unreadable 诊断（DEV-4）
    _emit_thread_started
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    _write_truncated_session >/dev/null
    _check_first_task
    exit 0
    ;;

  archived_no_id_fallback)
    # session_id 已知，但全库找不到 id 命中的 rollout；归档目录里有一个只有 cwd
    # 无 id 的 rollout → 归档目录必须参与 mtime/cwd 降级并被采集（DEV-4）
    _emit_thread_started
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    _write_archived_session_no_id "rollout-20260101-000000-noid.jsonl" >/dev/null
    _check_first_task
    exit 0
    ;;

  no_session_at_all)
    # 完全不写 native session（$CODEX_HOME/sessions 目录不存在）
    # → 采集必须落 warning 且不阻塞 oneshot（REQ-030）
    _emit_thread_started
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    _check_first_task
    exit 0
    ;;

  home_decoy)
    # 采集期在真实 HOME config 目录写入与 thread_id 同名的 rollout，刻意忽略 CODEX_HOME。
    # 用于验证 session 采集不会回落到 $HOME/.codex：正确实现必须保持 warning 且不复制。
    _emit_thread_started
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    _decoy_dir="$HOME/.codex/sessions/2026/01/01"
    mkdir -p "$_decoy_dir"
    printf '%s\n' "{\"type\":\"session_meta\",\"payload\":{\"id\":\"$thread_id\",\"cwd\":\"/decoy\"}}" \
      > "$_decoy_dir/rollout-20260101-000000-${thread_id}.jsonl"
    _check_first_task
    exit 0
    ;;

  completed_then_rc1)
    # 合法 success 终态事件，但 CLI 进程以非零退出
    # → terminal_status=success 不得掩盖非零退出（退出原因仍须是 provider_failed）
    _emit_thread_started
    _emit_item_completed_agent_message "Done."
    _emit_turn_completed
    exit 1
    ;;

  *)
    printf 'mock-codex: unknown scenario: %s\n' "$scenario" >&2
    exit 1
    ;;
esac
