#!/usr/bin/env bash
# tests/fixtures/mock-claude — Claude CLI test double
# 模拟 claude CLI `--output-format stream-json --verbose` 行为：
# stdout 输出 JSONL events 流，末尾 result 事件含 is_error / result / session_id
# cwd_hash 严格步骤顺序：先 realpath 解 symlink，再字符替换为 -
# 参见 docs/architecture/integrations.md §Claude Session 机制
set -euo pipefail

session_id=""
received_effort=""
received_skip_permissions="false"
received_allowed_tools=""

# 解析 --session-id / --effort / 权限 flag（其余 flag 忽略）
# 权限 flag 记录用于 QA-1 的权限审计回归：adapter 源码声明的权限参数必须与实际 argv 一致
while [[ $# -gt 0 ]]; do
  case "$1" in
    --session-id)   session_id="$2";      shift 2 ;;
    --effort)       received_effort="$2"; shift 2 ;;
    --dangerously-skip-permissions) received_skip_permissions="true"; shift ;;
    --allowedTools) received_allowed_tools="$2"; shift 2 ;;
    *)              shift ;;
  esac
done

scenario="${RALPH_MOCK_CLAUDE_SCENARIO:-happy}"

# cwd_hash：先 realpath，再字符替换（步骤顺序固定，见 PM-0002）
_cwd_hash() {
  local resolved
  resolved="$(realpath "$1")"
  printf '%s' "$resolved" | sed 's/[^A-Za-z0-9-]/-/g'
}

# 输出 stream-json events（stdout，逐行 JSONL）
# 末尾 result 事件 schema：{type:"result", subtype:"success", is_error:bool, result:str, session_id:str, _received_effort?:str}
_emit_init() {
  printf '{"type":"system","subtype":"init","session_id":"%s","_received_skip_permissions":%s,"_received_allowed_tools":"%s"}\n' \
    "$session_id" "$received_skip_permissions" "$received_allowed_tools"
}

_emit_result_ok() {
  printf '{"type":"result","subtype":"success","is_error":false,"result":"done","session_id":"%s","_received_effort":"%s"}\n' \
    "$session_id" "$received_effort"
}

_emit_result_err() {
  local msg="$1"
  printf '{"type":"result","subtype":"error","is_error":true,"result":%s,"session_id":"%s"}\n' \
    "$(printf '%s' "$msg" | jq -Rs .)" "$session_id"
}

_emit_conversation_events() {
  cat << 'ENDJSONL'
{"type":"assistant","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Let me think about this task."},{"type":"text","text":"I will complete this"},{"type":"tool_use","id":"tool1","name":"Bash","input":{"command":"echo hello"}}]},"uuid":"u2","timestamp":"2024-01-01T00:00:01.000Z"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"tool1","content":"hello\n"}]},"uuid":"u3","timestamp":"2024-01-01T00:00:02.000Z"}
ENDJSONL
}

_post_stream_sleep() {
  local sleep_sec="${RALPH_MOCK_CLAUDE_POST_STREAM_SLEEP:-0}"
  [[ "$sleep_sec" == "0" || -z "$sleep_sec" ]] && return 0
  sleep "$sleep_sec"
}

# 写 ~/.claude(_CONFIG_DIR)/projects/<cwd_hash>/<id>.jsonl —— provider native session
_write_native_session() {
  local file="$1"
  local long_input
  long_input="$(printf 'x%.0s' {1..5000})"
  cat > "$file" << ENDJSONL
{"type":"user","message":{"role":"user","content":"Do one task"},"uuid":"u1","timestamp":"2024-01-01T00:00:00.000Z"}
{"type":"assistant","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Let me think about this task."},{"type":"text","text":"I will complete this"},{"type":"tool_use","id":"tool1","name":"Bash","input":{"command":"echo hello","content":"$long_input"}}]},"uuid":"u2","timestamp":"2024-01-01T00:00:01.000Z"}
{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"tool1","content":"hello\n"}]},"uuid":"u3","timestamp":"2024-01-01T00:00:02.000Z"}
{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"Done."}]},"uuid":"u4","timestamp":"2024-01-01T00:00:03.000Z"}
ENDJSONL
}

# 勾选 TASKS.md 第 1 条未勾选任务（通过 RALPH_WORKSPACE，使 run 退出 done）
_check_first_task() {
  if [[ -n "${RALPH_WORKSPACE:-}" ]]; then
    _tasks="${RALPH_WORKSPACE}/.ralph/TASKS.md"
    if [[ -f "$_tasks" ]]; then
      _tmpout="$(mktemp)"
      _found=0
      while IFS= read -r _line || [[ -n "$_line" ]]; do
        if [[ "$_found" -eq 0 && "$_line" =~ ^([[:space:]]*-[[:space:]]+)\[[[:space:]]\](.*)$ ]]; then
          printf '%s[x]%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" >> "$_tmpout"
          _found=1
        else
          printf '%s\n' "$_line" >> "$_tmpout"
        fi
      done < "$_tasks"
      mv "$_tmpout" "$_tasks"
    fi
  fi
}

case "$scenario" in
  happy)
    _emit_init
    _emit_conversation_events
    _emit_result_ok
    _post_stream_sleep

    # 写 native session（供 collect + history 派生使用）
    cwd_hash="$(_cwd_hash "$PWD")"
    jsonl_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$cwd_hash"
    mkdir -p "$jsonl_dir"
    _write_native_session "$jsonl_dir/${session_id}.jsonl"

    _check_first_task
    exit 0
    ;;

  mtime_fallback)
    # stream events 正常；但 native session 文件名 UUID 与 session_id 不匹配（触发 mtime 降级）
    _emit_init
    _emit_result_ok
    _post_stream_sleep
    cwd_hash="$(_cwd_hash "$PWD")"
    jsonl_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$cwd_hash"
    mkdir -p "$jsonl_dir"
    _write_native_session "$jsonl_dir/00000000-0000-0000-0000-000000000000.jsonl"
    exit 0
    ;;

  missing_session)
    # stream events 正常，但不写任何 native session 文件
    _emit_init
    _emit_result_ok
    _post_stream_sleep
    exit 0
    ;;

  home_decoy)
    # 采集期（provider_started_at 之后）在真实 HOME config 目录写入与本次 run 同 cwd 的诱饵
    # session，刻意忽略 CLAUDE_CONFIG_DIR。用于验证 session 采集不会回落到 $HOME/.claude：
    # 正确实现必须保持 capture_status=warning 且不复制；若实现回落 HOME，mtime 降级会采走诱饵。
    _emit_init
    _emit_result_ok
    cwd_hash="$(_cwd_hash "$PWD")"
    decoy_dir="$HOME/.claude/projects/$cwd_hash"
    mkdir -p "$decoy_dir"
    printf '%s\n' '{"type":"user","message":{"role":"user","content":"decoy session"}}' \
      > "$decoy_dir/decoy-session.jsonl"
    _post_stream_sleep
    _check_first_task
    exit 0
    ;;

  is_error_auth)
    _emit_init
    _emit_result_err "Authentication failed: unauthorized"
    _post_stream_sleep
    exit 0
    ;;

  is_error_rate)
    _emit_init
    _emit_result_err "Rate limited: 429 too many requests"
    _post_stream_sleep
    exit 0
    ;;

  is_error_quota)
    _emit_init
    _emit_result_err "Usage quota exceeded: credits exhausted"
    _post_stream_sleep
    exit 0
    ;;

  is_error_api)
    _emit_init
    _emit_result_err "API error: 500 internal server error"
    _post_stream_sleep
    exit 0
    ;;

  is_error_concurrency)
    _emit_init
    _emit_result_err "tool_use_concurrency error: concurrent tool calls not allowed"
    _post_stream_sleep
    exit 0
    ;;

  crash)
    # CLI 崩溃：不写任何 stdout，exit 1
    exit 1
    ;;

  truncated_then_result)
    # 截断行（模拟 timeout 杀进程 / stderr 交错写入）出现在合法 result 事件之前。
    # jq 遇非法 JSON 会退出并丢弃后续输入 → 必须靠 ralph_json_lines 过滤才不丢终态。
    _emit_init
    printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"cut off mid-wr\n'
    _emit_result_ok
    _check_first_task
    exit 0
    ;;

  is_error_missing)
    # result 事件存在但缺 is_error 字段（schema 漂移）→ terminal_status=unknown
    _emit_init
    printf '{"type":"result","subtype":"success","result":"done","session_id":"%s"}\n' "$session_id"
    _check_first_task
    exit 0
    ;;

  no_terminal_event)
    # 有事件流但无 result 终态事件；CLI 仍以 0 退出 → terminal_status=unknown
    _emit_init
    _emit_conversation_events
    _check_first_task
    exit 0
    ;;

  *)
    printf 'mock-claude: unknown scenario: %s\n' "$scenario" >&2
    exit 1
    ;;
esac
