# ralph-loop dogfood 配置
# 本文件 gitignore，不入仓；按需调整后 ralph run 即可

RALPH_PROVIDER=claude
RALPH_PROVIDER_CONFIG_DIR=~/.claude-glm

# 可选项（按需取消注释）
# RALPH_EFFORT=low                 # low / medium / high / xhigh / max（默认不传）
# RALPH_MAX_ITER=20                # 最大轮数，0 = 无限（默认 0）
# RALPH_TIMEOUT=600                # 单轮超时秒数，0 = 无限（默认 0）
# RALPH_STAGNATION_LIMIT=5         # 连续无进展轮数（默认 5）
# RALPH_MODEL=                     # 覆盖 provider 默认模型；留空走 provider 内置默认
